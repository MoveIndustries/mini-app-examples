# Movement Publishing Admin - Environment Variables

# Registry Contract Address (deployed app_registry contract)
NEXT_PUBLIC_REGISTRY_ADDRESS=0x...

# Network (testnet or mainnet)
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_INDEXER_URL=https://hasura.testnet.movementnetwork.xyz/v1/graphql
NEXT_PUBLIC_FULLNODE_URL=https://testnet.movementnetwork.xyz/v1
NEXT_PUBLIC_CHAIN_ID=250

# Admin Addresses (comma-separated)
# Note: These can also be hardcoded in src/lib/config.ts
# NEXT_PUBLIC_ADMIN_ADDRESSES=0x...,0x...

# ===========================================
# Security Scanning (Optional)
# ===========================================

# ZAProxy URL - Required for security scanning
# Run ZAP locally: docker run -p 8080:8080 ghcr.io/zaproxy/zaproxy:stable zap.sh -daemon -host 0.0.0.0 -port 8080 -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true
ZAP_BASE_URL=http://localhost:8080

# ZAP API Key (optional, but recommended for production)
# ZAP_API_KEY=your-api-key

# App URL for transaction collector (defaults to localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
